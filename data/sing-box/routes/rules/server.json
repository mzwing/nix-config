{
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "action": "sniff"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "preferred_by": [
          "mzwing-tailscale-endpoint"
        ],
        "action": "route",
        "outbound": "mzwing-tailscale-endpoint"
      },
      {
        "rule_set": [
          "geosite-anthropic",
          "claude"
        ],
        "action": "resolve",
        "strategy": "ipv4_only"
      },
      {
        "rule_set": [
          "geosite-anthropic",
          "claude"
        ],
        "action": "route",
        "outbound": "claude"
      }
    ],
    "auto_detect_interface": true,
    "final": "direct",
    "default_domain_resolver": "dns-remote",
    "default_http_client": "default-http-client"
  }
}
